# Dependencies
node_modules
.pnp
.pnp.js

# Turbo
.turbo

# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Address books. Only the per-chain records for real deployments are tracked;
# local anvil, forge-test and partial-run artifacts are not.
/addresses/*
!/addresses/addresses-*.json
/addresses/addresses-31337.json
!/addresses/tests/
/addresses/tests/*
!/addresses/tests/.gitkeep

# Docs
docs/

# Dotenv file
.env*
!.env.example

# Coverage files
coverage/
lcov.info

# Misc
.DS_Store
